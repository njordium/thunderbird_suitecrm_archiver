# Refuse a commit message carrying a tool-attribution marker.
#
# tools/build.sh already fails on one, but by then the message is in history and
# only a rewrite gets it out. Catching it here costs nothing and keeps the fix
# to editing the message you are already writing.
#
# Enable with:  git config core.hooksPath tools/hooks
set -euo pipefail
exec "$(dirname "$0")/../check-attribution.sh" --msg "$1"
