{
  "manifest_version": 3,
  "name": "SuiteCRM Email Archiver",
  "description": "Archive email into SuiteCRM in one click. Clicking the button searches Leads, Contacts, Accounts and Targets at the same time for the sender's address, so there is no module to choose and no search to type; pick a match and the email is filed, with its attachments. If the sender is not in the CRM yet, create a Lead or a Contact under an Account, pre-filled from their signature. Signs in with OAuth2 against the SuiteCRM V8 API and keeps only a rotating refresh token, so your CRM password is never stored and a Thunderbird upgrade does not sign you out. Requires a one-time OAuth2 Password client in SuiteCRM: see the Preferences tab for the setup steps.",
  "version": "0.2.2",
  "developer": {
    "name": "Kim Haverblad",
    "url": "https://njordium.com"
  },
  "author": "Kim Haverblad",
  "homepage_url": "https://njordium.com",
  "browser_specific_settings": {
    "gecko": {
      "id": "suitecrm-archiver@njordium.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["personalCommunications", "personallyIdentifyingInfo"]
      }
    }
  },
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "64": "src/icons/icon-64.png",
    "128": "src/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "messagesRead",
    "accountsRead",
    "downloads",
    "messagesUpdate",
    "addressBooks",
    "messagesTags",
    "messagesTagsList",
    "compose",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "scripts": [
      "src/background/index.js"
    ],
    "type": "module"
  },
  "message_display_action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "Archive to SuiteCRM",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "19": "src/icons/icon-19.png",
      "24": "src/icons/icon-24.png",
      "32": "src/icons/icon-32.png"
    }
  },
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "Archive to SuiteCRM",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "19": "src/icons/icon-19.png",
      "24": "src/icons/icon-24.png",
      "32": "src/icons/icon-32.png"
    },
    "allowed_spaces": [
      "mail"
    ]
  },
  "options_ui": {
    "page": "src/ui/options.html",
    "open_in_tab": false
  }
}
